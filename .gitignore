# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated platform ephemerals
**/Flutter/ephemeral/
**/ServiceDefinitions.json
**/Runner/GeneratedPluginRegistrant.*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output
/android/build/
**/.gradle/

# Local Claude Code state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local run scripts holding dart-define secrets (Groq/Google keys) — never commit
*.local.ps1
*.local.sh

# Build outputs of website/tools/record.mjs, and the reference clip.
website/*.mp4

# Local setup briefs and signing keys — LIVE CREDENTIALS, never commit.
OURMYND_SETUP.txt
OURMYND_MAC_HANDOFF.txt
AuthKey_*.p8
*.p8

# Scratch/setup documents that carry real credentials in plaintext.
# OURMYND_TESTFLIGHT_PROMPT.txt held the Groq API key and was untracked but NOT
# ignored, so a single `git add .` would have committed it.
OURMYND_TESTFLIGHT_PROMPT.txt
OURMYND_SETUP.txt
PROGRESS_PAUSE,TXT
beta_testers.txt

# Live Stripe signing secret pasted here while configuring the endpoint.
# Never commit: anyone holding it can forge webhook events and grant
# themselves a paid entitlement.
webhooki_secret.txt
*_secret.txt
.build-config/

# Scratch notes, pasted logs and one-off SQL that accumulate in the repo root
# while debugging. Several of them (code.txt, way.txt, RUN_ME_IN_SUPABASE.sql,
# "update_version 3.txt") carry real keys or connection strings in plaintext,
# and key.txt is named for exactly what it holds. None of it is source, so it
# is ignored as a class rather than one file at a time - a single `git add -A`
# was all that stood between these and a public history.
/*.txt
/*.sql
/*.webp
server/testnote_txt

# Xcode's resolved Swift package state for the macOS target. Tool output, and
# it churns on every open.
macos/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
macos/Runner.xcworkspace/xcshareddata/swiftpm/
