# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=*

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# If you use Supabase Auth, set this to your project's JWT secret so the server
# can verify the tokens the Flutter app already holds. Otherwise sign your own.
JWT_SECRET=replace-with-supabase-jwt-secret-or-your-own
JWT_ISSUER=ourmynd

# ── Google OAuth (real sign-in) ─────────────────────────────────────────────
# The OAuth *Web* Client ID from Google Cloud Console → APIs & Services →
# Credentials. The same value goes in web/index.html's google-signin-client_id
# meta tag. The server verifies the Google ID token's signature + this audience.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# iOS OAuth client id ("iOS" type, bundle com.ourmynd.app). Required: the Google
# iOS SDK addresses the ID token to THIS client, not to the serverClientId the
# app passes, so without it every iPhone sign-in fails the audience check.
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# ── Postgres (Supabase / RDS — NEVER local sqlite) ──────────────────────────
# Supabase: Project Settings → Database → Connection string (use the pooled 6543
# port for serverless, 5432 for a long-lived server like this one).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# ── Redis (Upstash / Elasticache) ───────────────────────────────────────────
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# ── LiveKit Cloud (voice / body-doubling SFU) ───────────────────────────────
LK_URL=wss://your-project.livekit.cloud
LK_API_KEY=APIxxxxxxxx
LK_API_SECRET=secretxxxxxxxx

# ── FCM (push notifications) ────────────────────────────────────────────────
# Path to the service-account JSON, or paste the JSON into FCM_SA_JSON directly.
FCM_SA_JSON=

# ── Stripe billing ──────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use TEST keys in dev. The secret key stays
# server-side; the publishable key is handed to the client. The webhook secret
# (Developers → Webhooks) is optional in dev - without it we reconcile by polling
# the Checkout Session when the user returns from the hosted payment page.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=
# Price ids from Dashboard → Product catalogue.
STRIPE_PRICE_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PLUS_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# Where Stripe hosted checkout redirects the browser back to (success/cancel).
# Emulator dev: http://localhost:8080 with `adb reverse tcp:8080 tcp:8080`.
# Production: your public https origin, e.g. https://api.ourmynd.app
PUBLIC_BASE_URL=
