<?xml version="1.0" encoding="utf-8"?>
<!-- Dark counterpart of values-v31/styles.xml. @color/launch_bg resolves to
     the dark background via values-night/colors.xml, so the system splash is
     the same near-black the app opens on. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
