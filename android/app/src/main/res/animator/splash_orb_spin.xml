<?xml version="1.0" encoding="utf-8"?>
<!-- One slow turn. Android caps the splash animation it will wait for at
     1000ms, so this is a single revolution rather than a loop - and because
     the folds are near-symmetrical, a full turn ends where it began and the
     hand-off to the shader orb has nothing to jump between. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="rotation"
    android:valueFrom="0"
    android:valueTo="360"
    android:duration="1000"
    android:interpolator="@android:anim/linear_interpolator" />
