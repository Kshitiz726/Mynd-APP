<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-Flutter window background. Plain white here meant a white flash
     ahead of a near-black app in dark mode; @color/launch_bg resolves per
     light/dark via values-night/colors.xml, so the OS hands over to the
     launch screen on the colour it is already showing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
</layer-list>
